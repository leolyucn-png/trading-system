name: daqiao_v1.0_sell_timing
system_id: daqiao_v1.0
description: 大乔卖点精准择时引擎·与小乔形成买卖闭环

# ====== 系统定位 ======
positioning:
  role: "全体系通用执行层卖点/做T/持有判定引擎"
  not_responsible_for: ["选股", "定方向", "定赛道", "宏观判断"]
  responsible_for: ["什么时候卖", "什么时候做T", "怎么拿住涨停不踏空"]
  priority_chain: ["张飞(顶层风控)", "诸葛亮/汉武帝/刘彻(选股定规则)", "大乔(卖点执行)", "龙虾(最终交易)"]
  paired_module: "小乔(买点择时) → 买卖闭环"
  core_principle: "硬规则底线不动，弹性区间优化；该卖果断卖，该拿拿住连板"

# ====== 一、四大标准卖点 ======
sell_points:
  point_1_volume_stagnation:
    name: "放量滞涨见顶型"
    priority: "最高优先级止盈"
    trigger_all:
      - "量比>1.5（对比20日均量，放量确认）"
      - "日内涨幅<1%，冲高回落收长上影线"
      - "主动卖盘占比>60%，资金持续流出"
      - "处于阶段高位，累计涨幅>15%"
    scenario: ["波段主升结束止盈", "短线冲高兑现"]
    action: "分批止盈：先卖50%，剩余看支撑"
    example: "晶方科技6/10: 48→44.88，放量滞涨=卖点1触发"

  point_2_pressure_resistance:
    name: "压力位遇阻回落型"
    priority: "波段止盈"
    trigger_all:
      - "冲击前期高点/年线/半年线等重要压力位，连续2次冲不过"
      - "触碰压力位后放量回落，半小时内未收复"
      - "板块同步走弱，无增量资金承接"
    scenario: ["反弹至压力位止盈", "震荡区间高抛"]
    action: "止盈70%，剩余仓位设支撑位止损"

  point_3_sentiment_climax:
    name: "情绪高潮一致型"
    priority: "题材兑现"
    trigger_all:
      - "张飞触发一致性收割预警（情绪看多>80%）"
      - "板块批量涨停，边角标的普涨"
      - "个股当日涨幅>5%，尾盘被动跟风拉升"
    scenario: ["题材高潮兑现", "板块行情末端止盈"]
    action: "全部止盈，不格局"
    example: "6/29医药高潮: 创新药+7.8%，次日分化暴跌→卖点3触发"

  point_4_break_stop:
    name: "放量破位止损型"
    priority: "风险管控"
    trigger_all:
      - "有效跌破20日线/前期关键支撑位（收盘价低于支撑2%）"
      - "跌破时量比>1.5（放量确认出货，非缩量洗盘）"
      - "刘备验证无实质利好，基本面逻辑无变化"
    scenario: ["趋势破位止损", "洗盘失败离场"]
    action: "无条件止损离场，不补仓摊平"
    today_example: "完美世界7/3: -5.4%独立暴跌+游戏板块最弱→卖点4接近触发"

# ====== 二、涨停专属规则 ======
limit_up:
  hold_conditions:
    description: "全部满足→持有至次日"
    conditions:
      - "封单量>流通盘0.5%，封单稳定无大幅撤单"
      - "板块内涨停个股>5只，题材情绪持续"
      - "个股为板块龙头/龙二"
      - "日内换手率<15%，筹码稳定"
      - "未触发张飞一致性收割预警"
    action: "持有至次日，不提前开板卖；次日不连板再处理"
    hanwu_exception: "汉武帝短线标的+5%硬止盈→可先卖一半，剩余符合条件持有到次日"
    today_example: "卧龙电驱7/3涨停+10%: 封单稳定→大乔建议留到次日"

  sell_conditions:
    description: "任一触发→立即卖"
    conditions:
      - "封单半小时内从>20万手降至<5万手"
      - "反复炸板，换手率>20%"
      - "板块内炸板率>30%，题材退潮"
      - "个股为板块后排跟风，非龙头"
      - "尾盘最后半小时炸板未回封"
    action: "炸板瞬间卖出全部，不博弈回封"

# ====== 三、日内做T规则 ======
intraday_t:
  t_sell_conditions:
    description: "全部满足→可做T卖出"
    conditions:
      - "日内冲高>3%，量能逐步萎缩，量价背离"
      - "触及日内压力位/前期高点，冲第二次不过"
      - "所属板块拐头向下，龙头个股回落"
      - "非主升浪阶段，处于震荡区间"
    t_sell_ratio: "卖出底仓的30%-50%，不全仓T出"
    buy_back_rule: "回落至支撑位缩稳后接回；当日不接回则次日开盘处理"

  t_forbid_conditions:
    description: "任一触发→禁止做T，避免T飞主升浪"
    conditions:
      - "个股刚突破平台，处于主升初期"
      - "板块刚启动，当日涨幅<2%，增量资金持续流入"
      - "个股涨停或接近涨停，封单稳定"
      - "早盘半小时快速拉升，量价同步健康"
      - "张飞触发情绪一致预警前的题材启动阶段"

# ====== 四、防卖飞铁律 ======
anti_sell_early:
  description: "六大禁止卖出场景—任一触发→禁止提前卖出"
  rules:
    - id: "缩量正常回调"
      condition: "量比<0.7 AND 日内跌幅<3% AND 无实质利空 AND 上升趋势中"
    - id: "首次回踩20日线"
      condition: "上升趋势首次回踩20日线 AND 未有效跌破 AND 尾盘有承接"
    - id: "板块启动首日"
      condition: "板块涨幅2%-5% AND 个股为龙二及以后 AND 尚未补涨"
      today_example: "海特高新7/3: 军工+2.67%→海特落后-5%→防卖飞规则触发→不应卖出"
    - id: "涨停封单稳定"
      condition: "符合涨停持有条件→持有至次日"
    - id: "突破后缩量回踩"
      condition: "前日放量突破平台 AND 当日缩量回踩 AND 未破突破位"
    - id: "核心逻辑未破坏"
      condition: "张飞未触发预警 AND 刘备验证催化仍在 AND 逻辑成立"

# ====== 五、跨系统联动 ======
cross_system:
  upstream:
    trigger_source: "诸葛亮/汉武帝/刘彻持仓标的→调用大乔卖点择时"
    top_constraint: "张飞一致性预警→所有持有建议自动失效→强制止盈止损"
    bottom_rule: "各模型原生硬止损/硬止盈铁律 > 大乔弹性建议（不突破底线）"
  
  pair_xiaoqiao:
    description: "小乔买→大乔卖 = 完整买卖闭环"
    shared_all_models: true
  
  system_layer:
    description: "张飞(风控)→秦始皇(仓位)→关羽(资金)→刘彻/汉武/诸葛(选股)→小乔(买)→大乔(卖)→龙虾(执行)"

# ====== 六、输出模板 ======
output:
  fields:
    - "标的名称"
    - "所属体系（诸葛亮波段/汉武帝短线/刘彻轮动）"
    - "卖点类型"
    - "操作建议（全部卖出/分批止盈/止损/持有/做T卖出）"
    - "建议卖出价位区间"
    - "卖出仓位比例"
    - "后续接回/持有条件"
    - "风险提示"
    - "信号失效条件"
  
  template: |
    ═══ 【大乔 卖点判定】 ═══
    标的: {stock_name} ({stock_code})
    体系: {source_model} | 卖点: {sell_type}
    操作: {action} | 仓位: {position_ratio}
    
    卖出区间: ¥{sell_low} - ¥{sell_high}
    后续策略: {follow_up}
    风险: {risk_warning}
    失效: {invalidation}
    ═══════════════════════

# ====== 七、今日实盘验证 ======
today_verification:
 卧龙电驱: "涨停持有条件全满足→建议持有至周一 ✅"
 亚玛顿: "竞价假突破+涨停→大乔涨停卖出规则检查→符合持有 ✅"
 完美世界: "独立暴跌-5.4%+板块最弱→接近卖点4放量破位止损 ⚠️"
 海特高新: "军工+2.67%→海特落后-5%→防卖飞规则3触发→不应卖出 ✅"
 天通股份: "同行垫底+振幅5%→非缩量回调→不触发防卖飞→可考虑减仓"
